# --- Server ---
PORT=3000

# --- PostgreSQL ---
DATABASE_URL=postgres://stt:stt@localhost:5432/stt
# Set to "true" on hosts that require SSL (Render, Neon, Supabase, Railway)
PGSSL=false

# --- Gemini Live (real-time transcription) ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use the Live model name currently listed in Google AI Studio for your key.
GEMINI_LIVE_MODEL=gemini-3.8-live
# If no GEMINI_API_KEY is set the app runs in DEMO mode with a fake transcriber
# so the whole pipeline (mic -> websocket -> db -> dashboard) can still be tried.
